# Solo entorno local de demostración. No publicar credenciales ni claves.
PORT=3000
HOST=127.0.0.1
SIM_PORT=3001
ACTUALIZACION_MS=10000
ADMIN_USUARIO=admin
ADMIN_CLAVE=NivoraDemo2026!
# Cookie segura tras configurar HTTPS en un despliegue.
COOKIE_SEGURA=false
# Origen público si se configura un proxy HTTPS; por ejemplo https://nivora.example
ORIGEN_PUBLICO=
# Web Push: generar una sola vez con npm run vapid y copiar aquí.
VAPID_SUBJECT=mailto:demo@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
